# Finish arranging every output before feh reads the desktop geometry.
~/.screenlayout/monitors.sh

xset s off &
xset -dpms &
xset s noblank &

# Eww is kept installed for optional widgets, but no longer starts with Openbox.

~/.fehbg &
alacritty &
picom &
nm-applet &
kdeconnectd &
if [ -x /usr/lib/polkit-kde-authentication-agent-1 ]; then
  /usr/lib/polkit-kde-authentication-agent-1 &
fi

# Import the X session into the user service manager, then let it supervise
# the long-running desktop helpers.
systemctl --user import-environment DISPLAY XAUTHORITY
systemctl --user restart supermachine-polybar.service supermachine-tiler.service
