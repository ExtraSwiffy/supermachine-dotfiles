#!/usr/bin/env bash
set -u

printf '\033[38;2;134;217;217m'
printf '%s\n' \
    '  ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓' \
    '  ┃             SuperOS              ┃' \
    '  ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛'
printf '\033[38;2;174;185;184m  Hyprland  --  Quickshell  --  Ready\033[0m\n\n'

if command -v fastfetch >/dev/null 2>&1; then
    fastfetch --logo none --key-padding-left 2
    printf '\n'
fi

exec bash --noprofile --rcfile "${XDG_CONFIG_HOME:-${HOME}/.config}/supermachine/terminal.bashrc"
