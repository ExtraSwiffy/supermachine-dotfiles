#!/usr/bin/env bash
set -euo pipefail

config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/supermachine"
stamp_file="${config_dir}/installed-at"
mkdir -p "${config_dir}"

if [[ ! -s "${stamp_file}" ]]; then
    installed_at=""
    if [[ -r /var/log/pacman.log ]]; then
        installed_at="$(sed -nE 's/^\[([^]]+)\].*\[ALPM\] installed filesystem .*/\1/p' /var/log/pacman.log | head -n 1)"
    fi
    if [[ -z "${installed_at}" ]]; then
        installed_at="$(stat -c '%w' / 2>/dev/null | cut -d. -f1)"
    fi
    if [[ -z "${installed_at}" || "${installed_at}" == "-" ]]; then
        installed_at="$(date --iso-8601=seconds)"
    fi
    printf '%s\n' "${installed_at}" > "${stamp_file}"
fi

installed_epoch="$(date --date="$(head -n 1 "${stamp_file}")" +%s 2>/dev/null || printf '0')"
now_epoch="$(date +%s)"
if (( installed_epoch <= 0 || installed_epoch > now_epoch )); then
    printf 'unknown\n'
    exit 0
fi

days=$(( (now_epoch - installed_epoch) / 86400 ))
if (( days == 1 )); then
    printf '1 day\n'
else
    printf '%d days\n' "${days}"
fi
