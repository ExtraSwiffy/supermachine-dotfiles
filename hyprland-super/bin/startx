#!/bin/sh
# SuperMachine keeps the familiar startx command while launching native Wayland.
if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
    printf '%s\n' "startx: a graphical session is already active." >&2
    exit 1
fi

console_state="${HOME}/.config/supermachine/console-mode"
console_runner="${HOME}/.local/bin/supermachine-console-mode"
log_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/supermachine/logs"
hypr_log="${log_dir}/hyprland.log"

mkdir -p "$log_dir"
if [ -f "$hypr_log" ] && [ "$(wc -c < "$hypr_log")" -gt 2097152 ]; then
    mv "$hypr_log" "${hypr_log}.previous"
fi
printf '\n[%s] Starting SuperMachine session\n' "$(date --iso-8601=seconds)" >> "$hypr_log"

while :; do
    if [ -e "$console_state" ] && [ -x "$console_runner" ]; then
        "$console_runner" session
        continue
    fi

    Hyprland --config "${HOME}/.config/hypr/hyprland.lua" >> "$hypr_log" 2>&1
    exit_code=$?
    systemctl --user stop supermachine-shell.service >/dev/null 2>&1 || true
    printf '[%s] Hyprland exited with code %s\n' "$(date --iso-8601=seconds)" "$exit_code" >> "$hypr_log"
    [ -e "$console_state" ] || break
done
