#!/usr/bin/env bash
set -uo pipefail

state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/supermachine"
log_dir="${state_dir}/logs"
report_dir="${state_dir}/reports"
mkdir -p "$log_dir" "$report_dir"
report="${report_dir}/report-$(date +%Y%m%d-%H%M%S).txt"

section() {
    printf '\n===== %s =====\n' "$1"
}

{
    printf 'SuperMachine diagnostic report\nCreated: %s\n' "$(date --iso-8601=seconds)"
    section "System"
    uname -a
    uptime
    free -h
    df -h /
    powerprofilesctl get 2>&1 || true
    section "Session processes"
    pgrep -af 'Hyprland|gamescope|steam|quickshell|qs -c' || true
    section "Hyprland version and errors"
    hyprctl version 2>&1 || true
    hyprctl configerrors 2>&1 || true
    hyprctl monitors all 2>&1 || true
    section "Quickshell service"
    systemctl --user status supermachine-shell.service --no-pager 2>&1 || true
    section "Recent Quickshell log"
    tail -n 300 "${log_dir}/quickshell.log" 2>&1 || true
    section "Recent Hyprland log"
    tail -n 300 "${log_dir}/hyprland.log" 2>&1 || true
    section "Recent Console Mode log"
    tail -n 400 "${log_dir}/console-mode.log" 2>&1 || true
    section "Current boot warnings and errors"
    journalctl -b -p warning..alert --no-pager -n 350 2>&1 || true
    section "Previous boot warnings and errors"
    journalctl -b -1 -p warning..alert --no-pager -n 250 2>&1 || true
    section "Reset and shutdown evidence"
    journalctl -b 0 -k --no-pager 2>&1 | grep -Ei 'previous system reset reason|machine check|hardware error|watchdog|thermal.*critical|panic' | tail -n 100 || true
    journalctl -b -1 --no-pager 2>&1 | grep -Ei 'shutdown|reboot|power key|watchdog|thermal.*critical|panic|out of memory|gpu.*(reset|fault|hang)' | tail -n 150 || true
    section "Recent crashes"
    coredumpctl --no-pager --since '2 days ago' 2>&1 | tail -n 100 || true
    find "${XDG_CACHE_HOME:-${HOME}/.cache}/quickshell/crashes" -maxdepth 2 -type f -printf '%TY-%Tm-%Td %TH:%TM  %p\n' 2>/dev/null | sort -r | head -n 100 || true
    section "Kernel graphics messages"
    journalctl -k -b --no-pager 2>&1 | grep -Ei 'amdgpu|nvidia|i915|drm|gpu|hang|fault|error' | tail -n 200 || true
} > "$report" 2>&1

ln -sfn "$report" "${report_dir}/latest.txt"
printf '%s\n' "$report"

if [[ "${1:-}" == "--open" ]] && command -v foot >/dev/null; then
    exec foot -e less "$report"
fi
